{
  "name": "pdf-toolkit",
  "displayName": "PDF Toolkit",
  "description": "View PDFs, export selected pages and extract embedded raster images. Prepare the content you need for your AI coding workflow and attach it to GitHub Copilot Chat.",
  "version": "2.4.1",
  "publisher": "TimHaintz",
  "author": {
    "name": "Tim Haintz",
    "url": "https://github.com/timhaintz"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/timhaintz/pdf-toolkit"
  },
  "bugs": {
    "url": "https://github.com/timhaintz/pdf-toolkit/issues"
  },
  "homepage": "https://github.com/timhaintz/pdf-toolkit#readme",
  "engines": {
    "vscode": "^1.118.1"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "pdf",
    "viewer",
    "document",
    "preview",
    "extract",
    "screenshot",
    "pages",
    "images",
    "export"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfToolkit.pdfCustomEditor",
        "displayName": "PDF Toolkit",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pdfToolkit.openPdf",
        "title": "Open PDF",
        "category": "PDF Toolkit"
      },
      {
        "command": "pdfToolkit.zoomIn",
        "title": "Zoom In",
        "category": "PDF Toolkit"
      },
      {
        "command": "pdfToolkit.zoomOut",
        "title": "Zoom Out",
        "category": "PDF Toolkit"
      },
      {
        "command": "pdfToolkit.resetZoom",
        "title": "Reset Zoom",
        "category": "PDF Toolkit"
      },
      {
        "command": "pdfToolkit.screenshotMenu",
        "title": "Screenshot Menu",
        "category": "PDF Toolkit",
        "icon": "$(device-camera)"
      },
      {
        "command": "pdfToolkit.extractAllPages",
        "title": "Screenshot All Pages",
        "category": "PDF Toolkit"
      },
      {
        "command": "pdfToolkit.extractCurrentPage",
        "title": "Screenshot Current Page",
        "category": "PDF Toolkit"
      },
      {
        "command": "pdfToolkit.extractCustom",
        "title": "Screenshot Custom...",
        "category": "PDF Toolkit"
      },
      {
        "command": "pdfToolkit.extractComposite",
        "title": "Screenshot Composite...",
        "category": "PDF Toolkit"
      },
      {
        "command": "pdfToolkit.browseExtracted",
        "title": "Browse Extracted PDFs",
        "category": "PDF Toolkit",
        "icon": "$(folder-library)"
      },
      {
        "command": "pdfToolkit.attachExtractedToCopilot",
        "title": "Attach Extracted Pages to Copilot Chat",
        "category": "PDF Toolkit"
      }
    ],
    "configuration": {
      "title": "PDF Toolkit",
      "properties": {
        "pdfToolkit.defaultZoom": {
          "type": "number",
          "default": 1,
          "description": "Default zoom level for PDF documents"
        },
        "pdfToolkit.showToolbar": {
          "type": "boolean",
          "default": true,
          "description": "Show the PDF toolbar"
        },
        "pdfToolkit.extractionQuality": {
          "type": "number",
          "default": 2,
          "description": "Quality scale for extracted images (1.0 = 72dpi, 2.0 = 144dpi, 3.0 = 216dpi)"
        },
        "pdfToolkit.extractionFormat": {
          "type": "string",
          "default": "png",
          "enum": [
            "png",
            "jpeg"
          ],
          "description": "Image format for extracted pages"
        },
        "pdfToolkit.screenshotsFolder": {
          "type": "string",
          "default": "PDF-Screenshots",
          "description": "Folder name for storing extracted PDF screenshots (relative to workspace root)"
        },
        "pdfToolkit.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging to the Output panel (PDF Toolkit Debug channel)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node --test test/*.test.cjs",
    "test:integration": "npm run compile && node scripts/test-integration.cjs",
    "package:vsix": "npm run lint && npm test && node scripts/package-vsix.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.118.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "^10.14.0",
    "jsonc-parser": "3.3.1",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  },
  "overrides": {
    "@eslint/config-array@^0.23.5": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree@^8.72.1": {
      "minimatch": "^11.0.1"
    },
    "@vscode/vsce@4.0.0": {
      "minimatch": "^11.0.1"
    },
    "eslint@^10.14.0": {
      "minimatch": "^11.0.1"
    }
  }
}
